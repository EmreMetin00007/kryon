{
  "profile": "strict-bounty-livenation",
  "note": "Live Nation Entertainment / Ticketmaster. Program bans bots, automated scanning tools and LLMs in discovery: autonomous agent runs are NOT permitted. This profile exists only for header compliance and manual workflows; do not approve unattended targets here.",
  "approval_required_tools": ["*"],
  "denied_tools": [
    "kali-tools_masscan_scan",
    "kali-tools_nikto_scan",
    "kali-tools_nuclei_scan",
    "kali-tools_sqlmap_test",
    "kali-tools_sqlmap_test_structured",
    "kali-tools_hydra_brute",
    "kali-tools_msfconsole",
    "kali-tools_sliver_command",
    "container-tools_*",
    "hunter_auto_fanout_variants",
    "hunter_fuzz_attack_surface",
    "web-advanced_*graphql_batch*",
    "web-advanced_*race*"
  ],
  "blocked_http_methods": ["DELETE", "PUT", "PATCH"],
  "blocked_paths": ["/delete", "/destroy", "/admin/delete"],
  "rate_limits": {
    "default": {"window_seconds": 60, "max_calls": 10},
    "conservative": {"window_seconds": 60, "max_calls": 10},
    "aggressive": {"window_seconds": 60, "max_calls": 10},
    "overrides": {}
  },
  "background_network_jobs": "deny",
  "fuzz_max_requests_per_call": 10,
  "required_request_headers": {
    "X-HackerOne-Research": "{handle}"
  },
  "allow_loopback": true,
  "allow_osint": true,
  "allow_public_labs": false
}
