include README.md
include pyproject.toml
include requirements.lock
include MANIFEST.in
recursive-include scripts *.py *.sh *.json
recursive-include mcp-servers *.py requirements.txt
include config/tool-capabilities.json
include config/executor-contract.example.json
include config/bounty-program-policy.json
include config/mcp-core-tools.json
