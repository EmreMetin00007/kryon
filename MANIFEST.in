include config/program-profiles/strict-bounty.json config/program-profiles/strict-bounty-anduril.json
include config/program-profiles/strict-bounty-coupang.json config/program-profiles/strict-bounty-expedia.json
include config/program-profiles/strict-bounty-rapyd.json config/program-profiles/vdp-nebius.json
